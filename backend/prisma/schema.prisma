generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SituacaoPedido {
  EM_ANDAMENTO
  FINALIZADO
}

enum PerfilUsuario {
  ADMINISTRADOR
  FUNCIONARIO
}

model Pedido {
  id                    Int               @id @default(autoincrement())
  codigo                String            @unique
  nomeCliente           String
  titulo                String
  dataInicio            DateTime
  situacao              SituacaoPedido    @default(EM_ANDAMENTO)
  etapaAtualId          Int?
  etapaAtual            Etapa?            @relation("EtapaAtualPedido", fields: [etapaAtualId], references: [id])
  criadoPorId           Int?
  criadoPor             Usuario?          @relation("PedidoCriadoPor", fields: [criadoPorId], references: [id])
  historicos            HistoricoEtapa[]
  observacoesEtapas     ObservacaoEtapa[]
  dataUltimaAtualizacao DateTime          @updatedAt
  criadoEm              DateTime          @default(now())
}

model Etapa {
  id                Int               @id @default(autoincrement())
  nome              String            @unique
  ordem             Int               @unique
  pedidosAtuais     Pedido[]          @relation("EtapaAtualPedido")
  historicos        HistoricoEtapa[]
  observacoesEtapas ObservacaoEtapa[]
}

model HistoricoEtapa {
  id        Int      @id @default(autoincrement())
  pedidoId  Int
  etapaId   Int
  usuarioId Int?
  dataHora  DateTime @default(now())

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  etapa   Etapa    @relation(fields: [etapaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model ObservacaoEtapa {
  id           Int      @id @default(autoincrement())
  pedidoId     Int
  etapaId      Int
  observacao   String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  etapa  Etapa  @relation(fields: [etapaId], references: [id])

  @@unique([pedidoId, etapaId])
}

model Usuario {
  id             Int              @id @default(autoincrement())
  nome           String
  email          String           @unique
  senhaHash      String
  perfil         PerfilUsuario
  cargo          String?
  telefone       String?
  ativo          Boolean          @default(true)
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt
  pedidosCriados Pedido[]         @relation("PedidoCriadoPor")
  historicos     HistoricoEtapa[]

  @@map("usuarios")
}
